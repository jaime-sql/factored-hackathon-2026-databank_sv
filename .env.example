# Copy to .env for local overrides. Leave values empty to keep the documented defaults.
# Never commit .env. Never put real customer data or production secrets in this repo.

ENVIRONMENT=
PORT=
LOG_LEVEL=

LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=
INPUT_COST_PER_MILLION=
OUTPUT_COST_PER_MILLION=
MAX_AGENT_STEPS=

# Leave DATABASE_URL empty for SQLite. A real app_rw URL is read from the
# environment only and stored in Cloud Run Secret Manager at deploy time.
# Never commit it.
DATABASE_URL=
OPS_DB_PATH=
BANK_DB_PATH=
EVAL_RUNNER_TOKEN=

HANDOFF_CONFIDENCE_THRESHOLD=
HANDOFF_RISK_THRESHOLD=
DISPUTE_WINDOW_DAYS=

SESSION_SECRET=
SESSION_TTL_HOURS=

CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
DEMO_AGENT_TOKEN=
DEMO_AGENT_EMAIL=
